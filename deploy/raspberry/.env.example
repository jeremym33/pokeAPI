# Copié en .env par installer.sh (avec un mot de passe généré). docker compose le lit automatiquement.

# Mot de passe de la base de données
POSTGRES_PASSWORD=a-changer

# Adresse du site : « :80 » pour le réseau local (http://adresse-du-raspberry),
# ou un nom de domaine (ex. pokedex.mondomaine.fr) pour le HTTPS automatique : ports 80 et 443 redirigés vers le Raspberry.
SITE_ADDRESS=:80

# Ports publiés par Caddy
HTTP_PORT=80
HTTPS_PORT=443

# Port de l'API, accessible seulement depuis le Raspberry (127.0.0.1)
API_PORT=8080

# Dépôt de l'application web, relatif à ce dossier (cloné à côté de pokeAPI par installer.sh)
POKEAPP_DIR=../../../pokeApp

# Mémoire de Java
JAVA_OPTIONS=-XX:MaxRAMPercentage=40

# Sauvegardes (sauvegarder.sh) : dossier et durée de conservation
BACKUP_DIR=/home/pi/sauvegardes-pokeapi
BACKUP_KEEP_DAYS=30
